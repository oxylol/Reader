# ---- Core ----
# Secret used to sign JWTs. CHANGE THIS. Generate: openssl rand -hex 32
SECRET_KEY=change-me-please-openssl-rand-hex-32

# Bootstrap admin account (created on first start if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Database ----
# Default SQLite (single box). For Postgres set e.g.:
# DATABASE_URL=postgresql+asyncpg://inkvault:inkvault@db:5432/inkvault
DATABASE_URL=sqlite+aiosqlite:////data/inkvault.db

# ---- Storage ----
# Where compressed CBZ libraries live (mounted volume in compose)
LIBRARY_DIR=/data/library

# ---- Compression ----
# webp or avif
IMAGE_FORMAT=webp
# 0.0 - 1.0  (maps to encoder quality 0-100)
IMAGE_QUALITY=0.8

# ---- Downloader ----
# how many chapters download in parallel
MAX_PARALLEL_DOWNLOADS=4
# how many page images fetch in parallel within a single chapter
DOWNLOAD_PAGE_CONCURRENCY=4
# polite per-source delay after each page request (seconds)
SOURCE_RATE_LIMIT_SECONDS=0.1

# ---- Source: comick ----
# The original comick shut down; live data is served by clone hosts running a
# Laravel API at the site origin under /api. comick.art works WITHOUT Cloudflare
# (default). comick.live fronts /api/search with Cloudflare — if you switch to
# it, set COMICK_NEEDS_CLOUDFLARE=true so requests route through FlareSolverr.
# If Browse is empty, check `GET /api/admin/sources/diagnose` for the real error.
COMICK_API_URL=https://comick.art
COMICK_SITE_URL=https://comick.art
COMICK_NEEDS_CLOUDFLARE=false

# ---- Cloudflare solver ----
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# ---- Auto-update followed series ----
# how often to check followed series for new chapters (minutes); 0 disables
AUTO_UPDATE_INTERVAL_MINUTES=360

# ---- Frontend ----
# host port the app is served on
APP_PORT=8080
