# ---- Core ----
# Secret used to sign JWTs. CHANGE THIS. Generate: openssl rand -hex 32
SECRET_KEY=change-me-please-openssl-rand-hex-32

# Bootstrap admin account (created on first start if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Database ----
# Default SQLite (single box). For Postgres set e.g.:
# DATABASE_URL=postgresql+asyncpg://inkvault:inkvault@db:5432/inkvault
DATABASE_URL=sqlite+aiosqlite:////data/inkvault.db

# ---- Storage ----
# Where compressed CBZ libraries live (mounted volume in compose)
LIBRARY_DIR=/data/library

# ---- Compression ----
# webp or avif
IMAGE_FORMAT=webp
# 0.0 - 1.0  (maps to encoder quality 0-100)
IMAGE_QUALITY=0.8

# ---- Downloader ----
MAX_PARALLEL_DOWNLOADS=4
# polite per-source delay between page requests (seconds)
SOURCE_RATE_LIMIT_SECONDS=0.5

# ---- Cloudflare solver ----
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# ---- Auto-update followed series ----
# how often to check followed series for new chapters (minutes); 0 disables
AUTO_UPDATE_INTERVAL_MINUTES=360

# ---- Frontend ----
# host port the app is served on
APP_PORT=8080
